{
  "name": "@xfeatures/athenaeum-cli",
  "version": "0.1.0",
  "description": "Personal command-line access to Xfeatures Athenaeum: sign in with your own Xfeatures Account, then search/read/propose from the terminal.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "athenaeum": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@xfeatures/athenaeum-sdk": "file:../athenaeum-sdk"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
